# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
indent_style = tab
tab_width = 4
insert_final_newline = true

[docker-compose.yml]
indent_size = 4

[*.yml]
indent_size = 4
indent_style = space
