  "db_name": "PostgreSQL",
  "query": "select\n    id,\n    network,\n    pub_network,\n    slug_name,\n    name,\n    standard,\n    power_ac,\n    power_dc,\n    updated,\n    not exists (\n        select operator_id from charge_price where operator_id = operator.id\n    ) as \"hide!\",\n    supported_types as \"supported_types: Vec<ChargeType>\",\n    url,\n    image,\n    ccs_plug_count,\n    type2_plug_count,\n    ccs_plug_count + type2_plug_count as \"sum_plug_count!\"\nfrom operator\nwhere ccs_plug_count > 0 or type2_plug_count > 0\norder by operator.name\n",
