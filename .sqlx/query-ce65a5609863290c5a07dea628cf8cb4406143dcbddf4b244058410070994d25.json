  "query": "\n        SELECT\n            link_banner.id,\n            link_banner.link_id,\n            link_banner.image as image_id,\n            i.file_path\n        FROM link_banner\n        LEFT JOIN image i ON link_banner.image = i.id\n        WHERE link_banner.status = 'deleted'\n        ",
