  "query": "select\n    operator.id,\n    operator.network,\n    operator.pub_network,\n    operator.slug_name,\n    operator.name,\n    operator.standard,\n    operator.updated,\n    operator.url,\n    operator.image,\n    operator.evse_id,\n    not exists (\n        select operator_id from charge_price\n        where operator_id = operator.id\n    ) as \"hide!\"\nfrom operator\nwhere\n    operator.network = $1\n    or lower(operator.name) = lower($2)\norder by operator.name\n",
