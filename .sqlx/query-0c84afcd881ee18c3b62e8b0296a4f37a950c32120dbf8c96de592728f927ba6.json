  "query": "select\n    pub_id as id,\n    l.source,\n    l.is_affiliate,\n    replace(i.file_path, ' ', '') as \"image!\",\n    frequency,\n    i.checksum,\n    greatest(link_banner.updated, i.updated) as \"updated!\"\nfrom link_banner\njoin link l on l.id = link_banner.link_id\njoin image i on i.id = link_banner.image\nwhere starts <= now() and expiration >= now()\n",
