  "query": "select\n    id,\n    network,\n    pub_network,\n    slug_name,\n    name,\n    standard,\n    updated,\n    url,\n    image,\n    evse_id,\n    not exists (\n        select operator_id from charge_price\n        where operator_id = operator.id\n    ) as \"hide!\"\nfrom operator\nwhere\n    search @@ websearch_to_tsquery($1)\n    or strict_word_similarity($1, slug_name) > 0.45\n",
