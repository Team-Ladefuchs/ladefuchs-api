  "query": "select \n    operator.pub_network as cpo_identifier, \n    checksum, \n    mime_type,\n    image.updated,\n    slug_name as cpo_name,\n    $1 || 'img/cpo/' || image.checksum as \"url!\"\nfrom image \n    join operator on image.id = operator.image\nwhere soft_delete = false\n",
