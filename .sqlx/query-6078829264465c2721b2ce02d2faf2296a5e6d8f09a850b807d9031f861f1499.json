  "query": "SELECT\n    tariff.id,\n    tariff.slug_name,\n    tariff.monthly_fee,\n    tariff.url,\n    tariff.relationship_id,\n    tariff.provider_name,\n    tariff.provider_customer_only,\n    tariff.standard,\n    tariff.image,\n    tariff.ad_hoc,\n    tariff.provider_id,\n    tariff.brand_only\nFROM tariff\nWHERE\n    tariff.relationship_id = $3\n    OR (tariff.internal_name = $1 AND lower(tariff.provider_name) = lower($2))\nLIMIT 1;\n",
